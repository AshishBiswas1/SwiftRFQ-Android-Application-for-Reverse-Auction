{
  "expo": {
    "name": "SwiftRFQ",
    "slug": "swiftrfq",
    "version": "1.0.0",
    "scheme": "swiftrfq",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./icons/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.swiftrfq.app",
      "adaptiveIcon": {
        "foregroundImage": "./icons/icon.png",
        "backgroundColor": "#17140F"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-notifications",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow SwiftRFQ to access your contacts to invite suppliers to your auctions."
        }
      ]
    ]
  }
}
