{
  "expo": {
    "name": "SwiftRFQ Mobile",
    "slug": "swiftrfq-mobile",
    "version": "1.0.0",
    "scheme": "swiftrfq",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.swiftrfq.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow SwiftRFQ to access your contacts to invite suppliers to your auctions."
        }
      ]
    ]
  }
}
